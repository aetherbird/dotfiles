# -----------------------------
# Theming is fun
# -----------------------------

window-theme = dark
title = GhosTTY

font-family = "JetBrains Mono"
font-size = 18
adjust-cell-height = 10%

background = #171928
foreground = #ebfafa

background-opacity = 0.94
#background-blur-radius = 60

window-padding-x = 4
window-padding-y = 4
window-width = 110
window-height = 32
window-save-state = always

cursor-style = bar
cursor-color = #37f499

selection-foreground = #ebfafa
selection-background = #bf4f8e

# bold-is-bright = false
confirm-close-surface = false
mouse-hide-while-typing = true
gtk-single-instance = true

shell-integration = detect
shell-integration-features = cursor,sudo

term = xterm-256color
unfocused-split-opacity = 0.5
wait-after-command = false

# 16-color palette
palette = 0=#21222c
palette = 1=#f9515d
palette = 2=#37f499
palette = 3=#e9f941
palette = 4=#9071f4
palette = 5=#f265b5
palette = 6=#04d1f9
palette = 7=#ebfafa
palette = 8=#7081d0
palette = 9=#f16c75
palette = 10=#69F8B3
palette = 11=#f1fc79
palette = 12=#a48cf2
palette = 13=#FD92CE
palette = 14=#66e4fd
palette = 15=#ffffff

